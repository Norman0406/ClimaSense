menu "ClimaSense MQTT"

    # Build-time DEFAULTS only, like "ClimaSense network": values saved in the setup portal
    # (NVS) take precedence. Credentials go in the git-ignored sdkconfig.defaults.local.

    config CLIMASENSE_MQTT_HOST
        string "Broker host name or IPv4 address"
        default ""
        help
            Empty: MQTT stays off until a broker is set (here or in the setup portal).

    config CLIMASENSE_MQTT_PORT
        int "Broker port"
        range 1 65535
        default 1883

    config CLIMASENSE_MQTT_USERNAME
        string "User name"
        default ""

    config CLIMASENSE_MQTT_PASSWORD
        string "Password"
        default ""

    config CLIMASENSE_MQTT_BASE_TOPIC
        string "Base topic"
        default "climasense"
        help
            Topics are <base>/<device id>/state and <base>/<device id>/status.

    config CLIMASENSE_MQTT_HA_DISCOVERY
        bool "Home Assistant discovery"
        default n

    config CLIMASENSE_MQTT_HA_PREFIX
        string "Home Assistant discovery prefix"
        default "homeassistant"

endmenu
