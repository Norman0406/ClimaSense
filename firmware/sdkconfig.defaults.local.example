#CONFIG_CLIMASENSE_MQTT_HOST="mosquitto.local"
#CONFIG_CLIMASENSE_MQTT_USERNAME="climasense"
#CONFIG_CLIMASENSE_MQTT_PASSWORD="mqtt-password"
