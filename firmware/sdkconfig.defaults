# Settings that differ from ESP-IDF's defaults. The generated `sdkconfig` is not versioned;
# delete it (or run `idf.py fullclean`) after changing this file.

CONFIG_IDF_TARGET="esp32c6"

# ESP32-C6-WROOM-1-N8: 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Console and logs on the chip's native USB (USB Serial/JTAG). UART0 is not brought out on the board.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Partition table with two OTA slots and a core dump partition (partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# On a crash, write a core dump to the coredump partition (ELF, the only format in ESP-IDF 6.1);
# the firmware reports it at the next boot (components/diagnostics).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# Build fingerprint: 16 hex characters of the app's ELF SHA-256, in the start-up banner and in
# core dumps (default 9), to match a crash with the .elf that decodes it.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

# A task watchdog timeout panics (core dump, then reboot) instead of only printing a warning.
CONFIG_ESP_TASK_WDT_PANIC=y

# Sockets: the setup portal's web server (up to 7 plus 3 internal), its DNS responder, SNTP,
# and later MQTT and OTA. Phones open several connections at once while probing for a portal.
CONFIG_LWIP_MAX_SOCKETS=16

# Updates over the air (step 8, decided 2026-11-20): only images signed with our key are accepted
# (RSA-3072, Secure Boot V2 scheme, checked when an update is installed; hardware Secure Boot is
# not enabled, so a USB flash still works). Only release builds are signed: every build here is
# unsigned, and the release workflow (.github/workflows/release.yml) signs the image afterwards
# with the key from the repository secret OTA_SIGNING_KEY. The running firmware's own signature block holds
# the public key that updates are checked against: a board accepts updates only after a signed
# release has been flashed onto it once over USB.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n

# A new image runs on trial until the firmware confirms it; a crash or reset before that returns
# to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Plain HTTP for downloads from a server on the local network. ESP-IDF marks this as risky
# because a fake server could deliver an image; the signature check above rejects any image not
# signed with our key, however it arrived. The firmware is not secret, so encryption adds nothing.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
