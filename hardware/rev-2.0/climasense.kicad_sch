	(text "3V3 BUCK - MCU RAIL"
		(exclude_from_sim no)
		(at 144.78 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "14e1fed1-6ecf-58b1-a8c1-774cacc8f5f0")
	)
	(text "3V3_SENS LDO - SENSOR RAIL"
		(exclude_from_sim no)
		(at 266.7 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1a402bb8-0caf-540a-b330-a4323ae364cc")
	)
	(text "SENSORS - I2C ON +3V3_SENS (IO6 / IO7)"
		(exclude_from_sim no)
		(at 213.36 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "20a502c8-b694-5b68-a8ac-fd42ed7e90dc")
	)
	(text "I2C addresses\n0x44  SHT45   temperature / humidity\n0x47  BMP580  pressure (SDO high)\n0x59  SGP41   VOC / NOx\n0x62  SCD41   CO2"
		(exclude_from_sim no)
		(at 350.52 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "23364fc7-33cd-5576-9e9f-8615b86d6b84")
	)
	(text "Boot: IO9 low at reset enters download mode (IO8 must be high).\nUSB D+/D- go straight to the ESP32-C6 USB Serial/JTAG controller.\nIO6/IO7 are the LP I2C pins, usable from the low-power core.\nIO10 is unused (spare)."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3216ef62-168b-5e3f-9a94-69c8eddde8d6")
	)
	(text "QWIIC_EN is pulled low: the Qwiic supply is off by default. It is on IO11,\nwhich has no pull-up while the ESP32 is in reset.\nThe regulator limits the current, so a short on the connector cannot pull down the board."
		(exclude_from_sim no)
		(at 213.36 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5dc9a6b3-7217-5966-93bb-0e55e8d01b7b")
	)
	(text "QWIIC - OWN I2C BUS (IO19 / IO20), OWN SWITCHED SUPPLY"
		(exclude_from_sim no)
		(at 213.36 203.2 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "669564a0-9394-5d91-9934-7d9c0fd4ab25")
	)
	(text "Values from the GDEY0213B74 specification, reference circuit (page 29).\nCapacitors 0603/0805, X5R/X7R, 25 V. PREVGH/PREVGL reach about +/-20 V.\nThe panel sits on the back of the board; its FPC passes through a slot and turns\nback into J5, so panel pin N is connector pin 25 - N."
		(exclude_from_sim no)
		(at 431.8 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99d073b1-aafc-5813-9b5f-5dd23042f92f")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9b62812e-08ee-516b-b4e4-2fdacbe2f17d")
	)
	(text "E-PAPER DISPLAY - GDEY0213B74 (SSD1680), 4-WIRE SPI"
		(exclude_from_sim no)
		(at 431.8 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9d199a1f-751e-5874-bb75-01c1d62b7537")
	)
	(text "SENS_EN is pulled high: sensors are on by default.\nThe MCU can pull it low to power-cycle the sensor rail."
		(exclude_from_sim no)
		(at 266.7 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9e816b7b-3ebc-5611-ad38-96fb61836596")
	)
	(text "VOUT = 0.6 V x (1 + 68k/15k) = 3.32 V"
		(exclude_from_sim no)
		(at 144.78 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9edd0633-8611-52ef-ba81-fccd8ba1e07a")
	)
	(text "Active low: drive the GPIO low to light a colour."
		(exclude_from_sim no)
		(at 137.16 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b8e53f00-4030-5373-941d-c9df574ad713")
	)
	(text "MCU"
		(exclude_from_sim no)
		(at 20.32 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c7befd7a-3043-5c34-841b-105651900e31")
