	(text "Values from the GDEY0213B74 specification, reference circuit (page 29).\nCapacitors 0603/0805, X5R/X7R, 25 V or more. PREVGH/PREVGL reach about +/-20 V.\nThe panel lies above the parts on a frame; its FPC folds back under it into J5,\nso panel pin N is connector pin N. C27 and C28 stand at the diodes."
		(exclude_from_sim no)
		(at 431.8 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0dd41855-2b1e-5cac-b102-d01641b916d7")
	)
	(text "3V3 BUCK - MCU RAIL"
		(exclude_from_sim no)
		(at 144.78 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "14e1fed1-6ecf-58b1-a8c1-774cacc8f5f0")
	)
	(text "3V3_SENS LDO - SENSOR RAIL"
		(exclude_from_sim no)
		(at 266.7 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1a402bb8-0caf-540a-b330-a4323ae364cc")
	)
	(text "I2C addresses\n0x44  SHT45   temperature / humidity\n0x47  BMP580  pressure (SDO high)\n0x59  SGP41   VOC / NOx\n0x62  SCD41   CO2"
		(exclude_from_sim no)
		(at 350.52 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1c7b0770-3f82-5c15-a419-50491662991d")
	)
	(text "Boot: IO9 low at reset enters download mode (IO8 must be high).\nUSB D+/D- go straight to the ESP32-C6 USB Serial/JTAG controller.\nIO6/IO7 are the LP I2C pins, usable from the low-power core.\nIO2 is unused (spare)."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "416c142d-9292-59ad-9196-812bfcbd8584")
	)
	(text "E-PAPER DISPLAY - GDEY0213B74 (SSD1680), 4-WIRE SPI"
		(exclude_from_sim no)
		(at 431.8 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "54cc9c0f-6831-5e15-8a5b-61a8c4cd1aa8")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9b62812e-08ee-516b-b4e4-2fdacbe2f17d")
	)
	(text "SENS_EN is pulled high: sensors are on by default.\nThe MCU can pull it low to power-cycle the sensor rail."
		(exclude_from_sim no)
		(at 266.7 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9e816b7b-3ebc-5611-ad38-96fb61836596")
	)
	(text "VOUT = 0.6 V x (1 + 68k/15k) = 3.32 V"
		(exclude_from_sim no)
		(at 144.78 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9edd0633-8611-52ef-ba81-fccd8ba1e07a")
	)
	(text "Active low: drive the GPIO low to light a colour."
		(exclude_from_sim no)
		(at 137.16 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a29f10c6-8673-5688-93de-dffa7c5974ac")
	)
	(text "MCU"
		(exclude_from_sim no)
		(at 20.32 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c7befd7a-3043-5c34-841b-105651900e31")
	)
	(text "SENSORS - I2C ON +3V3_SENS (IO6 / IO7)"
		(exclude_from_sim no)
		(at 213.36 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ec116e8b-1702-587f-a04b-8a702bc9b0a7")
	)
	(text "QWIIC - OWN I2C BUS (IO19 / IO20), OWN SWITCHED SUPPLY"
		(exclude_from_sim no)
		(at 213.36 203.2 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ec529a8f-29b6-5d79-af4e-e7bcfdc33529")
	)
	(text "QWIIC_EN is pulled low: the Qwiic supply is off by default. It is on IO11,\nwhich has no pull-up while the ESP32 is in reset.\nThe regulator limits the current, so a short on the connector cannot pull down the board."
		(exclude_from_sim no)
		(at 213.36 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f1f04020-7d03-5425-8b25-3b9d06af0639")
	)
	(text "Fallback serial port (UART0), not populated: for flashing and boot messages\nif USB does not work. 3.3 V logic only. TX is the ESP32's output."
		(exclude_from_sim no)
		(at 149.86 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f715d5e3-1232-5c29-9364-8034fbc8c3fd")
	)
