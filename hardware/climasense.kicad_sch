	(text "3V3_SENS LDO - SENSOR RAIL"
		(exclude_from_sim no)
		(at 266.7 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1a402bb8-0caf-540a-b330-a4323ae364cc")
	)
	(text "Fallback serial port (UART0), not populated: for flashing and boot messages\nif USB does not work. 3.3 V logic only. TX is the ESP32's output."
		(exclude_from_sim no)
		(at 149.86 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3bf89801-cf44-5c78-a97d-5acffc09fe60")
	)
	(text "QWIIC_EN is pulled low: the Qwiic supply is off by default. It is on IO11,\nwhich has no pull-up while the ESP32 is in reset.\nThe regulator limits the current, so a short on the connector cannot pull down the board."
		(exclude_from_sim no)
		(at 213.36 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "48876d5f-4d8d-5bdd-9e4b-c74edac4931c")
	)
	(text "QWIIC - OWN I2C BUS (IO19 / IO20), OWN SWITCHED SUPPLY"
		(exclude_from_sim no)
		(at 213.36 203.2 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "88fe3f72-c39d-59ae-89c9-7d84e65d300c")
	)
	(text "SENSORS - I2C ON +3V3_SENS (IO6 / IO7)"
		(exclude_from_sim no)
		(at 213.36 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "90ce8bcc-8faf-51da-bea8-7819b7bde57c")
	)
	(text "USB-C INPUT"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9b62812e-08ee-516b-b4e4-2fdacbe2f17d")
	)
	(text "SENS_EN is pulled high: sensors are on by default.\nThe MCU can pull it low to power-cycle the sensor rail."
		(exclude_from_sim no)
		(at 266.7 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9e816b7b-3ebc-5611-ad38-96fb61836596")
	)
	(text "VOUT = 0.6 V x (1 + 68k/15k) = 3.32 V"
		(exclude_from_sim no)
		(at 144.78 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9edd0633-8611-52ef-ba81-fccd8ba1e07a")
	)
	(text "Active low: drive the GPIO low to light a colour."
		(exclude_from_sim no)
		(at 137.16 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b929837f-fb21-59f5-aa69-52b6c72ed952")
	)
	(text "MCU"
		(exclude_from_sim no)
		(at 20.32 96.52 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c7befd7a-3043-5c34-841b-105651900e31")
	)
	(text "Boot: IO9 low at reset enters download mode (IO8 must be high).\nUSB D+/D- go straight to the ESP32-C6 USB Serial/JTAG controller.\nIO6/IO7 are the LP I2C pins, usable from the low-power core."
		(exclude_from_sim no)
		(at 20.32 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c7d6e4e2-d891-57e3-925f-69ffd2044a34")
	)
	(text "I2C addresses\n0x44  SHT45   temperature / humidity\n0x47  BMP580  pressure (SDO high)\n0x59  SGP41   VOC / NOx\n0x62  SCD41   CO2"
		(exclude_from_sim no)
		(at 350.52 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f684a55f-a7df-5ffb-ba28-d7a81ba47b2c")
	)
